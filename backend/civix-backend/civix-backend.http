@civix_backend_HostAddress = http://localhost:5067

GET {{civix_backend_HostAddress}}/weatherforecast/
Accept: application/json

###

# --- Autenticación ---

# @name login
POST {{civix_backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "correo": "admin@civix.co",
  "password": "Admin123"
}

###

# Usuario actual y obras permitidas (usa el token del login anterior)
GET {{civix_backend_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.token}}

###

# Registro público: el usuario queda con rol Cliente
POST {{civix_backend_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "nombre": "Usuario Nuevo",
  "correo": "nuevo@civix.co",
  "password": "Nuevo1234"
}

###

# Materiales ahora requiere token
GET {{civix_backend_HostAddress}}/api/materiales
Authorization: Bearer {{login.response.body.$.token}}

###

# --- Administración de usuarios (requiere token de Administrador) ---

GET {{civix_backend_HostAddress}}/api/usuarios
Authorization: Bearer {{login.response.body.$.token}}

###

# Editar usuario (password null = conservar la actual)
PUT {{civix_backend_HostAddress}}/api/usuarios/3
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Cliente Demo",
  "correo": "cliente@civix.co",
  "rolId": 3,
  "activo": true,
  "password": null
}

###

# Desactivar (no se borra: tiene historial asociado)
DELETE {{civix_backend_HostAddress}}/api/usuarios/4
Authorization: Bearer {{login.response.body.$.token}}

###

POST {{civix_backend_HostAddress}}/api/usuarios/4/reactivar
Authorization: Bearer {{login.response.body.$.token}}

###
